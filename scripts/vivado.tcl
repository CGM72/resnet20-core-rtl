# One entry point: source scripts/vivado.tcl
# fpga::test relu | fpga::analyze relu | fpga::images relu
namespace eval fpga {
    variable root [file normalize [file join [file dirname [info script]] ..]]

    proc absolute {path} {
        variable root
        return [file normalize [file join $root $path]]
    }

    proc config {{target ""}} {
        variable root
        namespace eval ::fpga_project {variable settings {}; variable fixtures {}; variable targets {}}
        source [file join $root project.tcl]
        set cfg $::fpga_project::settings
        if {$target ne ""} {
            if {![dict exists $::fpga_project::targets $target]} {error "Unknown module $target. Choose: [dict keys $::fpga_project::targets]"}
            dict for {key value} [dict get $::fpga_project::targets $target] {dict set cfg $key $value}
        }
        foreach key {part top period_ns rtl_files} {
            if {![dict exists $cfg $key] || [dict get $cfg $key] eq ""} {error "project.tcl: missing $key"}
        }
        foreach {key default} {python auto clock_port {} include_dirs {} defines {} xdc_files {}} {
            if {![dict exists $cfg $key]} {dict set cfg $key $default}
        }
        if {![regexp {^[A-Za-z_][A-Za-z0-9_$]*$} [dict get $cfg top]]} {error "Invalid top module name"}
        foreach key {rtl_files xdc_files include_dirs} {
            set paths {}
            foreach path [dict get $cfg $key] {
                set path [absolute $path]
                if {$key eq "include_dirs"} {
                    if {![file isdirectory $path]} {error "Missing include directory $path"}
                } elseif {![file isfile $path]} {error "Missing $key file $path"}
                lappend paths $path
            }
            dict set cfg $key $paths
        }
        dict set cfg fixtures $::fpga_project::fixtures
        return $cfg
    }

    # A Tcl command prefix is a list: one executable path, or e.g. {py -3}.
    # Probe the interpreter, not just PATH entries (Windows Store aliases are not runtimes).
    proc python_command {{requested ""}} {
        if {$requested eq ""} {set requested [dict get [config] python]}
        set candidates {}
        if {$requested in {"" auto python}} {
            set candidates [list [list python] [list python3] [list py -3]]
            foreach key {LOCALAPPDATA ProgramFiles ProgramFiles(x86)} {
                if {![info exists ::env($key)]} {continue}
                set base $::env($key)
                set patterns {Python*/python.exe}
                if {$key eq "LOCALAPPDATA"} {
                    set patterns {Python/pythoncore-*/python.exe Programs/Python/Python*/python.exe}
                }
                foreach path [lsort -decreasing -dictionary [glob -nocomplain -types f -directory $base {*}$patterns]] {
                    lappend candidates [list $path]
                }
            }
        } elseif {[file exists $requested] || [file pathtype $requested] eq "absolute" ||
                  [string match -nocase *.exe $requested] || [regexp {[/\\]} $requested]} {
            set candidates [list [list $requested]]
        } else {
            # Allows an explicit launcher prefix such as {py -3.12}.
            if {[catch {llength $requested}]} {error "Invalid Python command/path: $requested"}
            set candidates [list $requested]
        }
        # Vivado may export PYTHONHOME/PYTHONPATH for its bundled interpreter.
        set probe {import argparse, sys; sys.exit(1) if sys.version_info < (3, 10) else print("FPGA_PYTHON_OK")}
        foreach command $candidates {
            set executable [lindex $command 0]
            set resolved [auto_execok $executable]
            set resolved_path [string map {\\ /} [lindex $resolved 0]]
            if {[string match -nocase */Microsoft/WindowsApps/python*.exe $resolved_path]} {continue}
            if {![catch {exec {*}$command -E -c $probe 2>@1} output] &&
                [lsearch -exact [split [string trim $output] "\n"] FPGA_PYTHON_OK] >= 0} {
                puts "Python: $command"
                return $command
            }
        }
        error {Python 3.10+ was not found. Pass its executable path to fpga::report_sim {C:/.../python.exe} or fpga::images <target> {C:/.../python.exe}, or set python in project.tcl.}
    }

    proc require_closed {} {
        # An empty project list avoids the Coretcl 2-88 diagnostic.
        if {[llength [get_projects -quiet]]} {
            error "Save/close the current project first: close_sim -force; close_project"
        }
    }

    # Close only projects generated by this tool.
    proc finish {} {
        if {![llength [get_projects -quiet]]} {return}
        set project [current_project]
        set name [file tail $project]
        if {[string match sim_* $name]} {
            catch {close_sim -force}
        } elseif {![string match design_* $name]} {
            error "Save/close this user project manually: $project"
        }
        close_project
    }

    proc period {value} {
        if {![string is double -strict $value] ||
            [catch {expr {double($value) > 0 && double($value) < Inf}} valid] || !$valid} {
            error "Clock period must be a positive finite value in ns"
        }
        return $value
    }

    proc manifest {tb} {
        variable root
        if {![regexp {^[A-Za-z_][A-Za-z0-9_$]*$} $tb]} {error "Use the actual TB name or its .sv filename"}
        set directory [file join $root tb $tb]
        set list_file [file join $directory "$tb.f"]
        set source [file join $directory "$tb.sv"]
        if {![file isfile $list_file] || ![file isfile $source]} {error "Missing matching TB files: $list_file / $source"}
        set fd [open $list_file r]
        set contents [read $fd]
        close $fd
        set sources {}
        foreach line [split $contents "\n"] {
            set line [string trim $line]
            if {$line eq "" || [string index $line 0] eq "#" || [string match {//*} $line]} {continue}
            set file [file normalize [file join $directory $line]]
            if {![file isfile $file]} {error "Missing TB source $file"}
            lappend sources $file
        }
        if {[lsearch -exact $sources $source] < 0} {error "$list_file must include $source"}
        return $sources
    }

    proc sim {testbench {python_exe ""} {target ""} {record_waves 1} {directory ""}} {
        variable root
        require_closed
        set cfg [config $target]
        set tb [file rootname [file tail $testbench]]
        set tb_sources [manifest $tb]
        if {$directory eq ""} {set directory [file join $root build sim $tb]}
        set tb_dir [file join $root tb $tb]
        file mkdir $directory
        if {$python_exe eq ""} {set python_exe [dict get $cfg python]}
        set options "-onfinish stop"
        if {[dict exists $cfg fixtures $tb]} {
            set fixture [dict get $cfg fixtures $tb]
            if {[dict exists $fixture files]} {
                dict for {argument path} [dict get $fixture files] {
                    set path [absolute $path]
                    if {![file exists $path]} {error "Missing fixture data $path"}
                    append options " -testplusarg \"$argument=$path\""
                }
            }
        }
        if {$tb eq "tb_core"} {
            set snr_dir [file join $directory snr]
            file mkdir $snr_dir
            foreach stale {scoreboard_results.txt results.json latency.txt logits_actual.hex} {
                file delete -force [file join $snr_dir $stale]
            }
            foreach stale [glob -nocomplain -directory $snr_dir layer_*_actual.hex] {
                file delete -force $stale
            }
            append options " -testplusarg \"snr_dir=$snr_dir\""
        }
        puts "Design top=[dict get $cfg top]; TB=$tb"
        create_project -force "sim_$tb" $directory -part [dict get $cfg part]
        set_property target_language Verilog [current_project]
        add_files -fileset sources_1 -norecurse [dict get $cfg rtl_files]
        add_files -fileset sim_1 -norecurse $tb_sources
        set_property top [dict get $cfg top] [get_filesets sources_1]
        set_property top $tb [get_filesets sim_1]
        set includes [dict get $cfg include_dirs]
        set_property include_dirs $includes [get_filesets sources_1]
        lappend includes $tb_dir
        if {[file isdirectory [file join $root tb common]]} {lappend includes [file join $root tb common]}
        if {[file isdirectory [file join $tb_dir include]]} {lappend includes [file join $tb_dir include]}
        set_property include_dirs $includes [get_filesets sim_1]
        foreach fileset {sources_1 sim_1} {
            set_property verilog_define [dict get $cfg defines] [get_filesets $fileset]
            update_compile_order -fileset $fileset
        }
        set_property xsim.elaborate.debug_level all [get_filesets sim_1]
        set_property xsim.simulate.runtime 0ns [get_filesets sim_1]
        set_property -dict [list xsim.simulate.xsim.more_options $options] [get_filesets sim_1]
        launch_simulation -simset sim_1 -mode behavioral
        if {$record_waves} {
            log_wave -r /$tb/*
            add_wave /$tb/*
        }
        run all
    }

    proc start_design {cfg directory clock_period} {
        file mkdir $directory
        set clock_file ""
        if {[dict get $cfg clock_port] ne ""} {
            set clock_file [file join $directory clock.xdc]
            set fd [open $clock_file w]
            puts $fd [format {create_clock -name design_clk -period %s [get_ports %s]} \
                $clock_period [list [dict get $cfg clock_port]]]
            close $fd
        }
        create_project -in_memory "design_[dict get $cfg top]" -part [dict get $cfg part]
        set options [list -sv]
        if {[llength [dict get $cfg include_dirs]]} {lappend options -include_dirs [dict get $cfg include_dirs]}
        if {[llength [dict get $cfg defines]]} {lappend options -define [dict get $cfg defines]}
        foreach source [dict get $cfg rtl_files] {read_verilog {*}$options $source}
        if {$clock_file ne ""} {read_xdc $clock_file}
        foreach xdc [dict get $cfg xdc_files] {read_xdc $xdc}
        synth_design -top [dict get $cfg top] -part [dict get $cfg part] -mode out_of_context
    }

    proc test {target} {
        set cfg [config $target]
        if {![dict exists $cfg tb]} {error "Set this module's tb in project.tcl targets, or use fpga::sim TB_NAME"}
        sim [dict get $cfg tb] "" $target
    }

    proc synth {{target ""} {clock_period ""}} {
        variable root
        require_closed
        if {$target ne "" && [string is double -strict $target]} {set clock_period $target; set target ""}
        set cfg [config $target]
        if {$clock_period eq ""} {set clock_period [dict get $cfg period_ns]}
        period $clock_period
        set top [dict get $cfg top]
        set directory [file join $root build synth $top]
        start_design $cfg $directory $clock_period
        report_utilization -file [file join $directory utilization.rpt]
        report_timing_summary -delay_type min_max -report_unconstrained -file [file join $directory timing.rpt]
        write_checkpoint -force [file join $directory "$top.dcp"]
        write_verilog -mode funcsim -force [file join $directory "${top}_funcsim.v"]
        puts "Synthesis results: $directory"
        return $directory
    }

    proc reports {directory stage} {
        variable root
        set timing [file join $directory timing]
        set utilization [file join $directory utilization]
        report_timing_summary -delay_type min_max -report_unconstrained \
            -name timing_$stage -file [file join $timing "$stage.rpt"]
        report_timing -delay_type max -max_paths 10 -file [file join $timing "${stage}_setup_paths.rpt"]
        report_timing -delay_type min -max_paths 10 -file [file join $timing "${stage}_hold_paths.rpt"]
        check_timing -verbose -file [file join $timing "${stage}_check_timing.rpt"]
        report_utilization -name utilization_$stage -file [file join $utilization "$stage.rpt"]
        report_utilization -hierarchical -file [file join $utilization "${stage}_hierarchical.rpt"]
    }

    # Native Vivado flow: no Python or image library is required for .rpt/DCP output.
    proc analyze {{target ""} {clock_period ""}} {
        variable root
        require_closed
        if {$target ne "" && [string is double -strict $target]} {set clock_period $target; set target ""}
        set cfg [config $target]
        if {$clock_period eq ""} {set clock_period [dict get $cfg period_ns]}
        period $clock_period
        set top [dict get $cfg top]
        set base [file join $root build analysis $top]
        set stamp [clock format [clock seconds] -format {run_%Y%m%d_%H%M%S}]
        set directory [file join $base $stamp]
        set suffix 1
        while {[file exists $directory]} {set directory [file join $base "${stamp}_$suffix"]; incr suffix}
        foreach child {timing utilization checkpoints sources} {file mkdir [file join $directory $child]}
        # Capture inputs now: later PNG export must not hash a subsequently edited RTL.
        set originals [concat [dict get $cfg rtl_files] [dict get $cfg xdc_files] [list [file join $root project.tcl]]]
        foreach inc [dict get $cfg include_dirs] {
            set originals [concat $originals [glob -nocomplain -directory $inc *.vh *.svh]]
        }
        set captured {}; set index 0
        foreach source [lsort -unique $originals] {
            set copy [file join $directory sources "[format %03d $index]_[file tail $source]"]
            file copy -force $source $copy
            lappend captured $copy
            incr index
        }
        set snapshot [dict create top $top part [dict get $cfg part] clock_port [dict get $cfg clock_port] period_ns $clock_period sources $captured]
        set fd [open [file join $directory run_info.tcldict] w]; puts $fd $snapshot; close $fd
        puts "Analysis results: $directory"
        if {[catch {
            start_design $cfg $directory $clock_period
            reports $directory post_synth
            write_checkpoint -force [file join $directory checkpoints "${top}_post_synth.dcp"]
            opt_design
            place_design
            if {[dict get $cfg clock_port] ne "" || [llength [dict get $cfg xdc_files]]} {phys_opt_design}
            route_design
            report_route_status -file [file join $directory timing post_route_route_status.rpt]
            reports $directory post_route
            report_drc -file [file join $directory timing post_route_drc.rpt]
            write_checkpoint -force [file join $directory checkpoints "${top}_post_route.dcp"]
        } message options]} {
            puts stderr "Analysis failed. Partial reports: $directory"
            return -options $options $message
        }
        set fd [open [file join $base latest.txt] w]; puts $fd $directory; close $fd
        puts "Timing report: [file join $directory timing post_route.rpt]"
        puts "Utilization report: [file join $directory utilization post_route.rpt]"
        if {$target eq "core"} {
            set header [list "Implementation: measured | Vivado [version -short] | [dict get $cfg part] | $clock_period ns"                 "Implementation source: $directory"]
            set timing [timing_metrics [file join $directory timing post_route.rpt]]
            set resources [utilization_metrics [file join $directory utilization post_route.rpt]]
            write_text_report core_report.txt $header [list \
                "Timing (post-route)" [compact_timing $timing] \
                "Utilization (post-route)" [compact_utilization $resources]]
            source [file join $root scripts report_html.tcl]
            write_html_report $cfg $clock_period $directory $timing $resources
        }
        return $directory
    }

    # Cache entries point at completed runs. Missing outputs cause a fresh measurement.
    proc cached_report_run {pointer outputs} {
        if {![file isfile $pointer]} {return ""}
        set fd [open $pointer r]
        set directory [string trim [read $fd]]
        close $fd
        foreach name $outputs {
            if {![file isfile [file join $directory $name]]} {return ""}
        }
        return $directory
    }

    proc measure_and_finish {command args} {
        set failed [catch {$command {*}$args} result options]
        set close_failed [catch {finish} close_result close_options]
        if {$failed} {return -options $options $result}
        if {$close_failed} {return -options $close_options $close_result}
        return $result
    }

    proc read_text_file {path} {
        set fd [open $path r]
        set failed [catch {read $fd} result options]
        close $fd
        if {$failed} {return -options $options $result}
        return $result
    }

    proc timing_metrics {path} {
        set text [read_text_file $path]
        set header_found 0
        set values {}
        foreach line [split $text "\n"] {
            if {[string match {*WNS(ns)*TNS(ns)*WHS(ns)*THS(ns)*WPWS(ns)*TPWS(ns)*} $line]} {
                set header_found 1
                continue
            }
            if {!$header_found} {continue}
            set row [regexp -all -inline {\S+} $line]
            if {[llength $row] != 12} {continue}
            set valid 1
            foreach value $row {
                if {$value ni {N/A NA - --} && ![string is double -strict $value]} {
                    set valid 0
                    break
                }
            }
            if {$valid} {set values $row; break}
        }
        if {![llength $values]} {
            if {![regexp -nocase {no (timing )?(paths|clocks)( were)? (found|defined)} $text]} {
                error "Cannot find Setup, Hold and Pulse Width summary in $path"
            }
            set values [lrepeat 12 N/A]
        }
        set metrics {}
        foreach name {Setup Hold {Pulse Width}} {worst total failing endpoints} $values {
            set status N/A
            if {[string is double -strict $worst] && [string is double -strict $total] &&
                [string is integer -strict $failing] && [string is integer -strict $endpoints] && $endpoints > 0} {
                set status [expr {$worst < 0 || $total < 0 || $failing > 0 ? "VIOLATED" : "MET"}]
            }
            dict set metrics $name [list $worst $total $failing $endpoints $status]
        }
        return $metrics
    }

    proc compact_timing {metrics} {
        set summary [format "%-12s %11s %11s %9s %9s %9s" "Check" "Worst(ns)" "Total(ns)" "Failing" "Endpoints" "Status"]
        dict for {name values} $metrics {
            append summary "\n" [format "%-12s %11s %11s %9s %9s %9s" $name {*}$values]
        }
        return $summary
    }

    proc utilization_metrics {path} {
        set labels [dict create {slice luts} LUT {clb luts} LUT             {slice registers} FF {clb registers} FF             {block ram tile} BRAM {block ram} BRAM dsps DSP dsp48e1 DSP dsp48e2 DSP \
            slice SLICE {lut as logic} LOGIC]
        set values {}
        set used_index -1
        set available_index -1
        foreach line [split [read_text_file $path] "\n"] {
            set line [string trim $line]
            if {![string match {|*} $line]} {continue}
            set columns {}
            foreach column [split [string trim $line |] |] {
                lappend columns [string trim $column]
            }
            set lower [string tolower $columns]
            set used [lsearch -exact $lower used]
            set available [lsearch -exact $lower available]
            if {$used >= 0 && $available >= 0} {
                set used_index $used
                set available_index $available
                set percent_index [lsearch -exact $lower util%]
                if {$percent_index < 0} {set percent_index [lsearch -exact $lower utilization%]}
                continue
            }
            set resource [string trimright [string tolower [lindex $columns 0]] "* "]
            if {$used_index < 0 || ![dict exists $labels $resource]} {continue}
            set key [dict get $labels $resource]
            if {[dict exists $values $key]} {continue}
            set count [lindex $columns $used_index]
            set capacity [lindex $columns $available_index]
            if {$count eq "" || $capacity eq ""} {continue}
            set percent ""
            if {$percent_index >= 0} {set percent [lindex $columns $percent_index]}
            dict set values $key [list $count $capacity $percent]
        }
        foreach key {LUT FF BRAM DSP} {
            if {![dict exists $values $key]} {error "Cannot find $key utilization in $path"}
        }
        return $values
    }

    proc compact_utilization {values} {
        set summary {| Resource | Used | Available | Util% |}
        foreach {key label} {LUT {Slice LUTs} FF {Slice Registers} BRAM {Block RAM Tile} DSP DSPs} {
            foreach {count capacity percent} [dict get $values $key] {
                append summary "\n| $label | $count | $capacity | $percent |"
            }
        }
        return $summary
    }

    proc write_text_report {name header sections} {
        variable root
        set version_file [open [file join $root VERSION] r]
        set release_version [string trim [read $version_file]]
        close $version_file
        if {![regexp {^[0-9]+\.[0-9]+\.[0-9]+$} $release_version]} {error "Invalid VERSION"}
        set output [file join $root reports $name]
        set version_report [file join $root reports generated "v$release_version" $name]
        file mkdir [file dirname $output]
        set temporary [file join [file dirname $output] ".core-report-[pid]-[clock clicks].tmp"]
        set fd [open $temporary {WRONLY CREAT EXCL}]
        set failed [catch {
            puts $fd "ResNet-20 core report"
            puts $fd "Version: $release_version"
            foreach line $header {puts $fd $line}
            foreach {title contents} $sections {
                puts $fd "\n=== $title ==="
                puts $fd [string trimright $contents "\r\n"]
            }
        } result options]
        set close_failed [catch {close $fd} close_result close_options]
        if {!$failed && !$close_failed} {
            set failed [catch {file rename -force $temporary $output} result options]
        }
        if {$failed || $close_failed} {file delete -force $temporary}
        if {$failed} {return -options $options $result}
        if {$close_failed} {return -options $close_options $close_result}
        file mkdir [file dirname $version_report]
        file copy -force $output $version_report
        puts "Core report: $output"
        puts "Version report: $version_report"
        return $output
    }

    proc report {{clock_period ""}} {
        variable root
        measure_and_finish analyze core $clock_period
        return [file join $root reports core_report.txt]
    }

    proc report_sim {{python_exe ""} {simulator auto}} {
        variable root
        set cfg [config core]
        set python [python_command $python_exe]
        set helper [file join $root scripts report_tools.py]
        set cache [file join $root build report_cache]
        file mkdir $cache

        set verilator [lindex [auto_execok verilator] 0]
        if {$simulator eq "auto"} {
            set simulator [expr {$verilator eq "" ? "xsim" : "verilator"}]
        }
        set vivado_version [version -short]
        switch -- $simulator {
            xsim {set simulator_version $vivado_version}
            verilator {
                if {$verilator eq ""} {error "Verilator is not on PATH. Use fpga::report_sim {} xsim."}
                set simulator_version [exec $verilator --version]
            }
            default {error "Simulator must be auto, xsim or verilator"}
        }

        set rtl [dict get $cfg rtl_files]
        set includes [dict get $cfg include_dirs]
        set defines [dict get $cfg defines]
        set part [dict get $cfg part]
        set launcher [file join $root scripts vivado.tcl]
        set common_inputs [concat $rtl $includes]
        foreach source $rtl {
            foreach ext {vh svh} {
                lappend common_inputs {*}[glob -nocomplain -directory [file dirname $source] *.$ext]
            }
        }
        set common_inputs [lsort -unique $common_inputs]

        set tb_dir [file join $root tb tb_core]
        set tb_includes [concat $includes [list $tb_dir [file join $tb_dir include]]]
        set tb_common [file join $root tb common]
        if {[file isdirectory $tb_common]} {lappend tb_includes $tb_common}
        set vectors [absolute [dict get $cfg fixtures tb_core files vectors_dir]]
        set weights [absolute [dict get $cfg fixtures tb_core files weight_path]]
        set golden [file join $root verification core golden_ref]
        set oracle [file join $root verification resnet20]
        set sim_inputs [concat $common_inputs $tb_includes [manifest tb_core]             [list $tb_dir $vectors $weights $launcher $helper                 [file join $oracle float_reference.py] [file join $oracle resnet20.c]]             [glob -nocomplain -directory $golden *.py]]
        set sim_key [exec {*}$python -E $helper key             --value=[list $simulator $simulator_version $part $rtl $includes $defines $vectors $weights]             -- {*}$sim_inputs]
        set sim_pointer [file join $cache "sim-$sim_key.txt"]
        set snr_dir [cached_report_run $sim_pointer {snr.txt latency.txt results.json scoreboard_results.txt}]
        set simulation reused
        if {$snr_dir eq ""} {
            set simulation measured
            set run [file join $cache "sim-[pid]-[clock clicks]"]
            puts "Running full-model simulation using $simulator"
            if {$simulator eq "verilator"} {
                set snr_dir $run
                set args {}
                foreach path $tb_includes {
                    lappend args --include=$path
                }
                foreach define $defines {lappend args --define=$define}
                exec {*}$python -E $helper simulate --verilator $verilator --run $snr_dir                     --vectors $vectors --weights $weights {*}$args -- {*}$rtl {*}[manifest tb_core]
            } else {
                set snr_dir [file join $run snr]
                measure_and_finish sim tb_core "" core 0 $run
            }
            set snr [exec {*}$python -E [file join $golden check_snr.py]                 --run $snr_dir --vectors $vectors --weights $weights]
            if {![file isfile [file join $snr_dir latency.txt]]} {error "Missing simulation latency report: $snr_dir"}
            set fd [open [file join $snr_dir snr.txt] w]
            puts $fd $snr
            close $fd
            set fd [open $sim_pointer w]
            puts $fd $snr_dir
            close $fd
        }

        set header [list "Simulation: $simulation | $simulator | $simulator_version"             "Simulation source: $snr_dir"]
        return [write_text_report snr_latency.txt $header [list \
            "SNR (dB)" [read_text_file [file join $snr_dir snr.txt]] \
            "Latency (cycles)" [read_text_file [file join $snr_dir latency.txt]]]]
    }

    proc compare {args} {
        variable root
        set python [python_command]
        set output [exec {*}$python -E [file join $root scripts compare_reports.py]             --reports-dir [file join $root reports] -- {*}$args]
        puts "Version comparison: $output"
        return $output
    }

    # Optional PNG conversion, separate from native Vivado measurement.
    proc images {{target ""} {python_exe ""}} {
        variable root
        if {[file isdirectory $target]} {
            set directory [file normalize $target]
            set cfg [config]
        } else {
            set cfg [config $target]
            set latest [file join $root build analysis [dict get $cfg top] latest.txt]
            if {![file isfile $latest]} {error "Run fpga::analyze $target first"}
            set fd [open $latest r]; set directory [string trim [read $fd]]; close $fd
        }
        set fd [open [file join $directory run_info.tcldict] r]
        set snapshot [string trim [read $fd]]; close $fd
        if {$python_exe eq ""} {set python_exe [dict get $cfg python]}
        set command [python_command $python_exe]
        set exporter [file join $root scripts export_analysis.py]
        puts [exec {*}$command -E $exporter check --period [dict get $snapshot period_ns]]
        puts [exec {*}$command -E $exporter init --results $directory --period [dict get $snapshot period_ns] \
            --top [dict get $snapshot top] --part [dict get $snapshot part] \
            --clock-port [dict get $snapshot clock_port] --sources {*}[dict get $snapshot sources]]
        foreach stage {post_synth post_route} {
            puts [exec {*}$command -E $exporter export --results $directory --stage $stage]
        }
        return $directory
    }
}
